<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- تم اصلی برنامه -->
    <style name="Base.Theme.Yadino" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">#0A0A0A</item>
        <item name="android:navigationBarColor">#0A0A0A</item>
    </style>

    <!-- تم صفحه لودینگ (Splash) -->
    <style name="Theme.Yadino.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0A0A0A</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/yadino_logo</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Base.Theme.Yadino</item>
    </style>
</resources>
